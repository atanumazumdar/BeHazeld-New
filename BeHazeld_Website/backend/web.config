<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS web.config — BeHAZEL'd FastAPI (backend)
  ─────────────────────────────────────────────
  Requires on the IIS server:
    • URL Rewrite 2.x  (iis.net/downloads/microsoft/url-rewrite)
    • Application Request Routing 3.x  (iis.net/downloads/microsoft/application-request-routing)
    • ARR proxy enabled at server level (IIS → ARR Cache → Server Proxy Settings → Enable proxy)

  This site listens on HTTPS (443) and forwards all traffic to
  uvicorn running on 127.0.0.1:8000.
-->
<configuration>
  <system.webServer>

    <!-- ── HTTPS redirect ──────────────────────────────────────────── -->
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- ── Reverse proxy to uvicorn ──────────────────────────── -->
        <rule name="Proxy to FastAPI" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>

      <!-- Pass X-Forwarded-* headers so FastAPI sees the real client -->
      <outboundRules>
        <rule name="Add X-Forwarded-Proto">
          <match serverVariable="HTTP_X_FORWARDED_PROTO" pattern=".*" />
          <action type="Rewrite" value="https" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- ── Security headers ───────────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Remove the IIS "Server" header -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- ── ARR proxy settings ─────────────────────────────────────── -->
    <proxy enabled="true" preserveHostHeader="true" />

    <!-- ── Request limits — allow large image uploads (50 MB) ─────── -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- ── Timeouts — generous for Cloudinary upload round-trips ──── -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
