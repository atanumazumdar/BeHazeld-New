# ═══════════════════════════════════════════════════════════════
#  BeHAZEL'd API — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# Local development (SQLite — no extra software needed):
DATABASE_URL=sqlite:///./store.db

# Production (MS SQL Server on Windows Server):
# DATABASE_URL=mssql+pyodbc://behazeld_app:YourStrongPassword@localhost/BeHAZELD?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Environment ───────────────────────────────────────────────
# Set to "production" to hide /docs and /redoc
ENVIRONMENT=development

# ── Admin Auth ────────────────────────────────────────────────
# Shared key used by the Next.js proxy to obtain a FastAPI JWT
ADMIN_API_KEY=change-me-before-production

# JWT signing secret (min 32 chars in production)
ADMIN_JWT_SECRET=change-me-jwt-secret

# JWT lifetime in seconds (default 24 h)
ADMIN_JWT_EXPIRY=86400

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local:
ALLOWED_ORIGINS=http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://www.behazeld.com,https://behazeld.com

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
