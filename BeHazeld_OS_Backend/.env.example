APP_ENV=development
APP_NAME=BeHazeld E-Commerce OS
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://behazeld_app:CHANGE_THIS_PASSWORD@127.0.0.1:5432/behazeld_os
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_PATH=C:\BeHazeld\data\uploads
PUBLIC_BASE_URL=https://api.behazeld.com
INVOICE_STORAGE_PATH=C:\BeHazeld\data\invoices
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://www.behazeld.com,https://behazeld.com,https://admin.behazeld.com
