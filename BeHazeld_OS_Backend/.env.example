APP_ENV=development
APP_NAME=BeHazeld E-Commerce OS
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_PATH=./var/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,https://thecompletestory.vercel.app
